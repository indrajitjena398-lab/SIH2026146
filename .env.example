# Server-side OpenRouter configuration. Never commit the real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Set true to return a provider error instead of the local evidence fallback.
OPENROUTER_REQUIRED=false# Bitcoin Investigation Platform Environment Configuration
APP_NAME="Bitcoin Sentinel"
APP_ENV="production"
PORT=8000
HOST="0.0.0.0"
DUCKDB_PATH="data/bitcoin.duckdb"
DEFAULT_RISK_THRESHOLD=30.0
